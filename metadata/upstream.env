SINGBOX_VERSION="v1.14.0"
SINGBOX_VERSION_PLAIN="1.14.0"

declare -A SINGBOX_SHA256=(
  [amd64]="2375de6999f4f56ab46b4fc5ddf26a6aba1d3e61a0f4e7ddec2f4690457d5f63"
  [arm64]="04d9b40bc98dc55b6f509ce3292145c65478f65866bea64826ebb2f382385088"
  [armv7]="1a8a205e9429c6317f30c5ec112d13345966a91348ae942c9c1645d4b6140063"
  [armv6]="e86e8068fb566aa032fe08058cdf9ef4b6218ab2c290eed41ded4aa9a0e6eb38"
)

declare -A SINGBOX_ASSET=(
  [amd64]="sing-box-1.14.0-linux-amd64.tar.gz"
  [arm64]="sing-box-1.14.0-linux-arm64.tar.gz"
  [armv7]="sing-box-1.14.0-linux-armv7.tar.gz"
  [armv6]="sing-box-1.14.0-linux-armv6.tar.gz"
)

# 下载源依次尝试（首个成功即停，SHA256 校验不因换源放松）：
# 1) 官方 GitHub Release；2) 本仓库同名 Release 镜像（弱网/GFW 环境可达性更高）
SINGBOX_MIRROR_BASE="https://github.com/${REPO_OWNER:-hynize}/${REPO_NAME:-singbox-manager}/releases/download/upgrade-mirror"

# cloudflared 默认跟随官方最新版：安装时通过 GitHub API 获取最新版本
# 与官方发布的 digest（SHA256）校验，不锁定版本。
CLOUDFLARED_LATEST="true"

# GitHub API 不可用时的降级链：
# 1) 版本号经 data.jsdelivr.com 镜像索引获取；
# 2) digest 无法获取时降级为"下载后实测 cloudflared version 与期望一致 + 可执行校验"；
# 3) 前两步都失败则回退到以下固定版本 + 固定 digest（完整 SHA256 校验）。
CLOUDFLARED_FALLBACK_VERSION="2026.8.3"

declare -A CLOUDFLARED_SHA256=(
  [amd64]="f29324fe934d1e100617484c78deef803c4dc2cd351d645bbde42e96b4fccc5e"
  [arm64]="4bcfd35521a7cbc545ebfd5d57334a71ee180e2a64874981f374c81472118391"
  [armv7]="d8bd9d00c15398ef4c6e6bc1a0486b6f1eb8c0dfd93e7479e07a121aa4e3dd57"
  [armv6]="7a7cac4ad4561ff55797eaf27aae1a0be37498c85502715bc87e3bad919d928c"
)

declare -A CLOUDFLARED_ASSET=(
  [amd64]="cloudflared-linux-amd64"
  [arm64]="cloudflared-linux-arm64"
  [armv7]="cloudflared-linux-armhf"
  [armv6]="cloudflared-linux-arm"
)

# cloudflared 下载源依次尝试
CLOUDFLARED_MIRROR_BASE="https://github.com/${REPO_OWNER:-hynize}/${REPO_NAME:-singbox-manager}/releases/download/upgrade-mirror"

# 低内存守卫：可用内存低于该值（MB）时收紧配置（cloudflared 强制 http2、提示少开协议）
SBM_LOW_MEM_MB="200"
